---
// src/components/Navbar.astro
import { SignedIn, SignedOut, UserButton, SignInButton } from '@clerk/astro/components';
---

<header class="bg-white border-b border-stone-100 shadow-sm">
  <div class="flex justify-between items-center p-4 max-w-7xl mx-auto w-full h-16 md:h-20">
    
    <div class="flex-shrink-0">
      <a href="/" class="flex items-center">
        <img src="/images/logo.png" alt="Aires de Gredos" class="h-8 md:h-12 w-auto" onerror="this.src='/favicon.svg'"/>
      </a>
    </div>

    <div class="flex items-center space-x-4">
      
      <div class="flex items-center">
        <SignedOut>
          <SignInButton mode="modal">
            <button class="text-xs md:text-sm font-semibold text-stone-600 bg-stone-50 px-3 py-1.5 rounded-full border border-stone-200 hover:bg-white transition-all">
              Entrar
            </button>
          </SignInButton>
        </SignedOut>
        <SignedIn>
          <UserButton afterSignOutUrl="/" />
        </SignedIn>
      </div>

      <a href="/carrito" class="relative group p-2 bg-[#5c4033] text-white rounded-full hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span id="cart-count" class="absolute -top-1 -right-1 bg-amber-500 text-white text-[10px] font-bold rounded-full h-5 w-5 flex items-center justify-center border-2 border-white shadow-sm">
          0
        </span>
      </a>
    </div>
  </div>

  <nav class="bg-stone-50/50 overflow-hidden border-t border-stone-100">
    <div class="flex overflow-x-auto py-3 px-4 gap-8 no-scrollbar md:justify-center">
      {['panaderia', 'bolleria', 'charcuteria', 'vinoteca', 'alimentacion'].map((cat) => (
        <a href={`/categoria/${cat}`} class="text-[11px] font-bold text-stone-500 hover:text-[#5c4033] transition-colors whitespace-nowrap uppercase tracking-widest">
          {cat}
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  #cart-count { transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
</style>

<script>
  import { cartItems } from '../store/cartStore';
  const counter = document.getElementById('cart-count');

  cartItems.subscribe(items => {
    const total = items.reduce((acc, item) => acc + (item.cantidad || 0), 0);
    if (counter) {
      counter.innerText = total.toString();
      counter.style.transform = 'scale(1.4)';
      setTimeout(() => { counter.style.transform = 'scale(1)'; }, 200);
    }
  });
</script>