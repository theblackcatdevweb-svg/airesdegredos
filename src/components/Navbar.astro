---
// src/components/Navbar.astro
import { SignedIn, SignedOut, UserButton, SignInButton } from '@clerk/astro/components';
---

<header class="bg-white border-b border-stone-100 shadow-sm">
  <div class="flex justify-between items-center p-4 max-w-7xl mx-auto w-full gap-4 h-24 md:h-32">
    
    <div class="flex-shrink-0">
      <a href="/" class="flex items-center">
        <img 
          src="/images/productos/ui/logo_aires_gredos.jpg" 
          alt="Aires de Gredos" 
          class="h-20 md:h-28 w-auto object-contain" 
        />
      </a>
    </div>

    <div class="flex items-center gap-3">
      
      <div class="flex items-center">
        <SignedOut>
          <SignInButton 
            mode="modal" 
            class="bg-stone-800 text-white text-[11px] font-bold uppercase tracking-widest px-5 py-2.5 rounded-full shadow-sm cursor-pointer border-none hover:bg-stone-700 transition-all"
          >
            Entrar
          </SignInButton>
        </SignedOut>
        <SignedIn>
          <UserButton afterSignOutUrl="/" />
        </SignedIn>
      </div>

      <a href="/carrito" class="relative p-2.5 bg-[#5c4033] text-white rounded-full shadow-md transition-transform hover:scale-105">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span id="cart-count" class="absolute -top-1 -right-1 bg-amber-600 text-white text-[10px] font-bold rounded-full h-5 w-5 flex items-center justify-center border-2 border-white">0</span>
      </a>
    </div>
  </div>

  <nav class="bg-stone-50 border-t border-stone-100">
    <div class="flex overflow-x-auto py-3 px-4 gap-6 no-scrollbar md:justify-center">
      {['panaderia', 'bolleria', 'charcuteria', 'vinoteca', 'alimentacion'].map((cat) => (
        <a href={`/categoria/${cat}`} class="text-[11px] md:text-sm font-bold text-stone-600 hover:text-[#5c4033] transition-colors whitespace-nowrap uppercase tracking-widest">
          {cat}
        </a>
      ))}
    </div>
  </nav>
</header>

<style is:global>
  /* Mantenemos este CSS para ocultar el botón gris fijo que vimos en tu captura.
     Esto asegura que el ÚNICO botón visible sea el que está dentro del Navbar.
  */
  div.fixed.top-4.right-4.z-\[100\],
  button[data-clerk-unstyled-id]:not(.bg-stone-800) {
    display: none !important;
  }

  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  import { cartItems } from '../store/cartStore';
  const counter = document.getElementById('cart-count');
  cartItems.subscribe(items => {
    const total = items.reduce((acc, item) => acc + (item.cantidad || 0), 0);
    if (counter) counter.innerText = total.toString();
  });
</script>