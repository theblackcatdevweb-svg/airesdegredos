---
const { producto } = Astro.props;
---
<div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-stone-100 flex flex-col h-full">
  <div class="relative overflow-hidden aspect-square">
    <img 
      src={producto.imagen} 
      alt={producto.nombre} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 bg-stone-100"
      onload="this.style.opacity='1'"
      onerror="this.src='https://placehold.co/600x600?text=Cargando+Producto...'; this.style.opacity='0.7';"
    />
    <div class="absolute top-3 right-3 bg-white/90 backdrop-blur px-3 py-1 rounded-full font-bold text-[#3D2B1F] shadow-sm">
      {producto.precio.toFixed(2)}€
    </div>
  </div>
  
  <div class="p-5 flex flex-col flex-grow">
    <h3 class="text-lg font-bold text-[#3D2B1F] mb-2 leading-tight line-clamp-2">{producto.nombre}</h3>
    <p class="text-stone-500 text-sm mb-6 line-clamp-2 flex-grow">{producto.descripcion}</p>
    
    <button 
      class="add-to-cart w-full bg-[#3D2B1F] text-white py-3 rounded-xl font-bold hover:bg-[#8B5E3C] active:scale-95 transition-all"
      data-id={producto.id} 
      data-price-id={producto.priceId} 
      data-nombre={producto.nombre}
      data-precio={producto.precio}
      data-imagen={producto.imagen}
    >
      Añadir al Carrito
    </button>
  </div>
</div>

<style>
  img {
    opacity: 0;
    transition: opacity 0.3s ease-in;
  }
</style>

<script>
  import { addItem } from '../store/cartStore';

  // Ejecutamos la lógica cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    const addButtons = document.querySelectorAll('.add-to-cart');

    addButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const product = {
          id: btn.getAttribute('data-id'),
          nombre: btn.getAttribute('data-nombre'),
          precio: parseFloat(btn.getAttribute('data-precio') || '0'),
          imagen: btn.getAttribute('data-imagen'),
          priceId: btn.getAttribute('data-price-id')
        };
        
        addItem(product);
        
        // Pequeño feedback visual
        const originalText = btn.textContent;
        btn.textContent = "¡Añadido! ✓";
        btn.classList.add('bg-green-700');
        
        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove('bg-green-700');
        }, 1000);
      });
    });
  });
</script>