---
interface Props {
  titulo: string;
  subtitulo: string;
  imagen: string;
  enlace: string;
  textoEnlace: string;
}

const { titulo, subtitulo, imagen, enlace, textoEnlace } = Astro.props;
---

<section class="relative w-full h-[500px] flex items-center justify-center overflow-hidden my-16 shadow-2xl">
  <div class="absolute inset-0 z-0">
    <img 
      src={imagen} 
      alt={titulo}
      class="w-full h-full object-cover transition-transform duration-[10000ms] hover:scale-110"
    />
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  <div class="relative z-10 text-center px-6 max-w-4xl">
    <h2 class="text-5xl md:text-7xl font-serif font-bold text-white mb-6 drop-shadow-2xl">
      {titulo}
    </h2>
    <p class="text-xl md:text-2xl text-[#FDFCF0] mb-10 font-light italic drop-shadow-lg">
      {subtitulo}
    </p>
    <a 
      href={enlace} 
      class="bg-[#FDFCF0] text-[#3D2B1F] px-10 py-4 rounded-full font-bold text-lg 
             hover:bg-[#8B5E3C] hover:text-white transition-all duration-300 
             shadow-xl inline-block active:scale-95"
    >
      {textoEnlace}
    </a>
  </div>
</section>